limit_req_zone $binary_remote_addr zone=game_api:10m rate=10r/s;

server {
    listen ${WEB_PORT};
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 24k;
    include /etc/nginx/game-response-headers.conf;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /health { access_log off; return 200 'ok'; }
    location /api/ {
        limit_req zone=game_api burst=30 nodelay;
        limit_req_status 429;
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 15s;
        include /etc/nginx/game-response-headers.conf;
        add_header Cache-Control no-store always;
    }
    location ~* \.(glb|png|jpg|webp|woff2)$ {
        try_files $uri =404;
        expires 1d;
    }
    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/game-response-headers.conf;
        add_header Cache-Control no-cache;
    }
}
