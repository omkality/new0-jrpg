# Public bot ID, never a token. Used to verify Telegram's Ed25519 signature.
TELEGRAM_BOT_ID=9210184678
TELEGRAM_BOT_USERNAME=new0_game
# Optional HMAC compatibility for Telegram clients without Ed25519 initData.
# Enter only a newly issued token. This value is passed to the API, never Vite.
TELEGRAM_BOT_TOKEN=
LEADERBOARD_VERSION=prototype-001
LEADERBOARD_TITLE=Тестовый архив 001
# Prize mode stays closed until its rules and ties are agreed.
COMPETITION_OPEN=false
# 0 = unlimited. Only completed runs count. One active run per account.
ATTEMPT_LIMIT=0
ALLOW_GUEST=true
WEB_PUBLISH_PORT=8085
WEB_PORT=80
API_PORT=8000
API_HOST=0.0.0.0
# Local-only by default. Set 0.0.0.0 deliberately for LAN phone testing.
BIND_ADDRESS=127.0.0.1
PUBLIC_APP_URL=
SHOP_URL=https://new0.shop/
DROP_URL=https://new0.shop/
COMPOSE_PROJECT_NAME=new0-game
WEB_IMAGE=new0-game-web:dev
API_IMAGE=new0-game-api:dev
TEST_IMAGE=new0-game-tests:dev
# Healthchecks use a small wget binary, not a Python interpreter.
HEALTH_REQUEST_TIMEOUT_SECONDS=3
HEALTH_INTERVAL=15s
HEALTH_TIMEOUT=5s
HEALTH_RETRIES=5
HEALTH_START_PERIOD=10s
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
AUTH_MAX_AGE_SECONDS=900
SESSION_TTL_SECONDS=86400
RUN_TTL_SECONDS=7200
MIN_ACTION_INTERVAL_SECONDS=0.2
DIAGNOSTIC_TTL_SECONDS=86400
CLIENT_REQUEST_TIMEOUT_MS=30000
CLIENT_BOOTSTRAP_ATTEMPTS=3
# Optional host-based Vite workflow. Compose does not publish the API separately.
DEV_HOST=127.0.0.1
DEV_PORT=5173
DEV_API_TARGET=http://127.0.0.1:8000
# Preview has its own Compose project and isolated data volume.
PREVIEW_PROJECT_NAME=new0-preview
PREVIEW_PUBLISH_PORT=0
